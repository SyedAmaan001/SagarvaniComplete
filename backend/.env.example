# ========================================
# SAGARVANI / ORCA - Environment Variables
# ========================================

# Google Gemini API Keys (comma-separated or indexed for rotation)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GOOGLE_API_KEY=your_google_api_key_here

# Sarvam AI STT & Translation Keys (comma-separated for auto key rotation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Copernicus Marine Service (CMEMS) Credentials
COPERNICUS_USERNAME=your_copernicus_email@example.com
COPERNICUS_PASSWORD=your_copernicus_password

# Twilio SMS & WhatsApp Alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_TARGET_PHONE=your_default_target_phone

# Open-Meteo API (Free / Public - No Key Needed)
# Weather API: https://api.open-meteo.com/v1/forecast
# Marine API: https://marine-api.open-meteo.com/v1/marine

# ========================================
# Voice / mock mode / runtime (all optional)
# ========================================
# STT_MODE=auto        # auto (real if SARVAM_API_KEY set, else labelled mock) | real | mock
# STT_FALLBACK_TO_MOCK=true  # if real STT fails, return labelled demo text instead of an error
# TTS_MODE=auto        # auto (Sarvam if key set, else browser speech) | provider | browser
# SARVAM_TTS_MODEL=    # optional override; empty = provider default (bulbul:v2 is retired)
# SARVAM_TTS_SPEAKER=  # optional voice override
# DATA_MODE=live       # live | mock (mock = labelled demo numbers, never a go/no-go)
# CORS_ORIGINS=        # extra allowed origins, comma separated (added to defaults); * = any
# REDIS_URL=           # optional; falls back to in-memory sessions if unset/unreachable
# MAX_AUDIO_BYTES=10485760
# LOG_LEVEL=INFO
